# ── Supabase ────────────────────────────────────────────────────
# URL du projet Supabase (Settings → API → Project URL).
# Le backend accepte soit SUPABASE_URL, soit VITE_SUPABASE_URL.
SUPABASE_URL=               # ex: https://xxxx.supabase.co (optionnel si VITE_SUPABASE_URL est défini)
VITE_SUPABASE_URL=          # même URL, exposée au navigateur
VITE_SUPABASE_ANON_KEY=     # ex: eyJhbGciOiJIUzI1NiIs...

# Clé service_role (BACKEND UNIQUEMENT — ne jamais committer/exposer)
SUPABASE_SERVICE_ROLE_KEY=  # ex: eyJhbGciOiJIUzI1NiIs...

# ── Whop ────────────────────────────────────────────────────────
# Secret de signature du webhook (Dashboard → Developer → Webhooks).
WHOP_WEBHOOK_SECRET=        # ex: ws_...
